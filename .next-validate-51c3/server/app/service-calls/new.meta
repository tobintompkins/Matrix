{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/service-calls/layout,_N_T_/service-calls/new/layout,_N_T_/service-calls/new/page,_N_T_/service-calls/new"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/service-calls/new/__PAGE__",
    "/service-calls/new",
    "/service-calls",
    "/_index",
    "/_head"
  ]
}