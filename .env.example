# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Clerk Authentication (do not commit real keys — use .env.local)
# Get keys from: https://dashboard.clerk.com
# Or leave unset to use Clerk keyless development mode (SSO works locally).
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Customer portal (Patch 42)
# NEXT_PUBLIC_PORTAL_BASE_URL=http://localhost:3000/portal
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal/dashboard
# Portal support contact overrides (optional — defaults live in lib/portal/seed.ts)
# NEXT_PUBLIC_PORTAL_SUPPORT_EMAIL=service@matrix.example
# NEXT_PUBLIC_PORTAL_SUPPORT_PHONE=+1-555-0140

# Enterprise Inventory & Warehouse (Patch 43)
# NEXT_PUBLIC_INVENTORY_DEFAULT_WAREHOUSE_ID=wh-main
# NEXT_PUBLIC_ENABLE_BIN_LOCATIONS=true

# PM Intelligence (Patch 44)
# NEXT_PUBLIC_PM_DEMO_DATA=true
# NEXT_PUBLIC_PM_COUNT_FRESHNESS_DAYS=30

# -----------------------------------------------------------------------------
# Matrix Assist (Patch 48) — server-side only; never expose AI_API_KEY to the browser
# -----------------------------------------------------------------------------
# AI_ASSIST_ENABLED=true
# AI_PROVIDER=openai-compatible
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_ASSIST_DEV_SAMPLE=true
