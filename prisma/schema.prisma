// =============================================================================
// MATRIX ENTERPRISE DATABASE SCHEMA
// =============================================================================
// Architectural design for field service + digital twin + AI troubleshooting.
//
// Runtime today: SQLite (local / desktop / offline-friendly)
// Future: PostgreSQL on Railway (swap provider; keep cuid string IDs)
//
// UI is NOT connected. Seed data is NOT imported.
// Placeholder models are included so later patches do not require rewrites.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
// TENANCY & ACCESS CONTROL
// -----------------------------------------------------------------------------

/// Root tenant: one Matrix company / service organization.
/// Enables multiple companies, Railway multi-tenant, or single-org desktop mode.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  settings  String? // JSON blob for tenant preferences
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  syncedAt  DateTime?

  users              User[]
  roles              Role[]
  customers          Customer[]
  warehouseLocations WarehouseLocation[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  knowledgeArticles KnowledgeBaseArticle[]
  serviceBulletins   ServiceBulletin[]
  errorCodes         ErrorCode[]
  firmwareReleases   Firmware[]
}

/// Named capability set (Admin, Dispatcher, Technician, Inventory Clerk, etc.).
model Role {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  permissions    String? // JSON array of permission keys
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users UserRole[]

  @@unique([organizationId, name])
}

model User {
  id             String        @id @default(cuid())
  organizationId String
  email          String
  name           String?
  passwordHash   String?
  status         String? // active | inactive | invited
  organization   Organization  @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  syncedAt       DateTime?

  roles               UserRole[]
  assignedTickets     ServiceTicket[]          @relation("AssignedTechnician")
  technicianNotes     TechnicianNote[]
  requestedPartOrders PartOrder[]              @relation("RequestedByUser")
  attachments         Attachment[]             @relation("UploadedByUser")
  photos              Photo[]                  @relation("CapturedByUser")
  customerSignatures  CustomerSignature[]      @relation("CapturedByUser")
  aiConversations     AIConversation[]
  aiSessions          AITroubleshootingSession[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@unique([organizationId, email])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

// -----------------------------------------------------------------------------
// CUSTOMERS, SITES, FLEET
// -----------------------------------------------------------------------------

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  accountNumber  String?
  /// Patch 40 — enterprise CRM customer number (may mirror accountNumber).
  customerNumber String?
  status         String?
  industry       String?
  parentCustomerId String?
  taxId          String?
  billingAddress String?
  primaryAddress String?
  notes          String?
  website        String?
  timeZone       String?
  preferredBusinessHours String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  parentCustomer Customer?    @relation("CustomerHierarchy", fields: [parentCustomerId], references: [id])
  childCustomers Customer[]   @relation("CustomerHierarchy")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  syncedAt       DateTime?

  locations Location[]
  contacts  CustomerContact[]
  contracts CustomerContract[]
  documents CustomerDocument[]

  @@index([organizationId])
  @@index([customerNumber])
  @@index([parentCustomerId])
  @@index([status])
}

/// Customer site / room / plant (Customer Locations).
model Location {
  id         String   @id @default(cuid())
  customerId String
  name       String
  /// Patch 40 site number for enterprise lookups.
  siteNumber String?
  address    String?
  city       String?
  region     String?
  postalCode String?
  country    String?
  latitude   Float?
  longitude  Float?
  timezone   String?
  businessHours String?
  loadingDockInstructions String?
  parkingInstructions String?
  securityProcedures String?
  buildingAccessInstructions String?
  afterHoursAccess String?
  siteNotes String?
  assignedTechnician String?
  customer   Customer @relation(fields: [customerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  syncedAt   DateTime?

  printers Printer[]

  @@index([customerId])
  @@index([siteNumber])
}

/// Catalog of supported machine models (GD9630, GL9730, Valezus, FT/FW/X1 later).
model PrinterModel {
  id           String   @id @default(cuid())
  name         String   @unique
  series       String?
  deviceType   String?
  capabilities String? // JSON
  /// Editable maintenance interval setup (Patch 34) — copies between services.
  pmIntervalCopies         Int?
  cleaningIntervalCopies   Int?
  jointUnitIntervalCopies  Int?
  dtfPmIntervalCopies      Int?
  warningThresholdCopies   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  printers           Printer[]
  pmKitTemplates     PMKitTemplate[]
  parts              Part[]            @relation("PartCompatibleModels")
  knowledgeArticles  KnowledgeBaseArticle[]
  serviceBulletins   ServiceBulletin[]
  errorCodes         ErrorCode[]
  firmwareReleases   Firmware[]
  aiRecommendations  AIRecommendation[]
}

/// Physical printer asset (Digital Twin root).
model Printer {
  id             String       @id @default(cuid())
  locationId     String
  printerModelId String
  assetId        String?
  serialNumber   String?
  status         String?
  firmwareVersion String?
  controllerVersion String?
  installedAt    DateTime?
  warrantyStart  DateTime?
  warrantyEnd    DateTime?
  purchaseDate   DateTime?
  leaseInfo      String?
  ownership      String?
  macAddress     String?
  ipAddress      String?
  hostname       String?
  department     String?
  floor          String?
  room           String?
  latitude       Float?
  longitude      Float?
  qrLabel        String?
  barcode        String?

  /// Copy count & PM foundation (Patch 33–34) — nullable until live data is connected.
  currentCopyCount   Int?
  previousCopyCount  Int?
  monthlyVolume      Int?
  lastPMDate         DateTime?
  lastCleaningDate   DateTime?
  lastJointUnitDate  DateTime?
  lastDTFPMDate      DateTime?
  /// Date placeholders — volume-based date estimates deferred.
  nextPMDue          DateTime?
  nextCleaningDue    DateTime?
  nextJointUnitDue   DateTime?
  nextDTFDue         DateTime?
  /// Count baselines & calculated due counts (Patch 34).
  lastPMCopyCount         Int?
  lastCleaningCopyCount   Int?
  lastJointUnitCopyCount  Int?
  lastDTFPMCopyCount      Int?
  nextPMDueCount          Int?
  nextCleaningDueCount    Int?
  nextJointUnitDueCount   Int?
  nextDTFDueCount         Int?

  /// Per-machine interval overrides (Patch 45) — null = use model defaults when configuring.
  pmIntervalOverride            Int?
  cleaningIntervalOverride      Int?
  jointUnitIntervalOverride     Int?
  dtfPmIntervalOverride         Int?
  dueSoonThresholdOverride      Int?

  location       Location     @relation(fields: [locationId], references: [id])
  printerModel   PrinterModel @relation(fields: [printerModelId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  syncedAt       DateTime?

  serviceTickets      ServiceTicket[]
  workOrders          WorkOrder[]
  pmHistory           PMHistory[]
  partsInstalled      PartInstalled[]
  technicianNotes     TechnicianNote[]
  partOrders          PartOrder[]
  attachments         Attachment[]
  photos              Photo[]
  customerSignatures  CustomerSignature[]
  meterHistory        MeterHistory[]
  copyCountHistory    CopyCountHistory[]
  maintenanceCompletions MaintenanceCompletion[]
  maintenanceSchedules   MaintenanceSchedule[]
  maintenanceAuditLogs   MaintenanceAuditLog[]
  printerAlerts       PrinterAlert[]
  aiSessions          AITroubleshootingSession[]
  warranties          AssetWarranty[]
  lifecycleEvents     AssetLifecycleEvent[]
  relationshipsAsParent AssetRelationship[] @relation("AssetParent")
  relationshipsAsChild  AssetRelationship[] @relation("AssetChild")

  @@unique([assetId])
  @@index([locationId])
  @@index([printerModelId])
  @@index([serialNumber])
  @@index([qrLabel])
  @@index([barcode])
  @@index([ipAddress])
  @@index([hostname])
}

// -----------------------------------------------------------------------------
// SERVICE WORKFLOW
// -----------------------------------------------------------------------------

model ServiceTicket {
  id             String   @id @default(cuid())
  ticketNumber   String?
  printerId      String
  customerId     String?
  customerLocationId String?
  printerSerialNumber String?
  printerModel   String?
  title          String?
  description    String?
  problemCategory String?
  assignedToId   String?
  assignedBy     String?
  status         String?
  priority       String?
  source         String?
  jobType        String?
  issueSummary   String?
  problemDescription String?
  requestedBy    String?
  requestedByEmail String?
  requestedByPhone String?
  openedAt       DateTime?
  acknowledgedAt DateTime?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  technicianArrivalTime DateTime?
  workStartedAt  DateTime?
  workCompletedAt DateTime?
  closedAt       DateTime?
  responseTimeMinutes Int?
  repairTimeMinutes Int?
  totalDowntimeMinutes Int?
  meterCountAtOpen Int?
  meterCountAtClose Int?
  resolutionSummary String?
  internalNotes  String?
  customerNotes  String?
  customerSignature String?
  customerSignatureDate DateTime?
  customerSatisfactionRating Int?
  followUpRequired Boolean @default(false)
  followUpDate   DateTime?
  warrantyStatus String?
  serviceContractStatus String?
  billable       Boolean  @default(true)
  laborHours     Float?
  travelHours    Float?
  mileage        Float?
  remoteResolution Boolean @default(false)
  escalationLevel Int     @default(0)
  parentTicketId String?
  active         Boolean  @default(true)
  printer        Printer  @relation(fields: [printerId], references: [id])
  assignedTo     User?    @relation("AssignedTechnician", fields: [assignedToId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  syncedAt       DateTime?

  technicianNotes    TechnicianNote[]
  partOrders         PartOrder[]
  attachments        Attachment[]
  photos             Photo[]
  customerSignatures CustomerSignature[]
  aiSessions         AITroubleshootingSession[]
  workOrders         WorkOrder[]
  ticketUpdates      ServiceTicketUpdate[]
  ticketParts        ServiceTicketPart[]
  ticketAttachments  ServiceTicketAttachment[]
  ticketLabor        ServiceTicketLabor[]
  dispatchAssignments DispatchAssignment[]

  @@unique([ticketNumber])
  @@index([printerId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([customerId])
  @@index([printerSerialNumber])
}

/// Enterprise work order backbone (Patch 37) — UI uses sessionStorage until wired.
model WorkOrder {
  id                   String   @id @default(cuid())
  workOrderNumber      String   @unique
  title                String
  description          String?
  customerId           String?
  siteId               String?
  printerId            String?
  serviceTicketId      String?
  serviceType          String?
  priority             String?
  status               String?
  source               String?
  assignedTechnician   String?
  secondaryTechnician  String?
  requestedBy          String?
  createdBy            String?
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  actualStart          DateTime?
  actualEnd            DateTime?
  completedDate        DateTime?
  estimatedHours       Float?
  actualHours          Float?
  travelTime           Float?
  mileage              Float?
  laborRate            Float?
  laborCost            Float?
  notes                String?
  internalNotes        String?
  customerVisibleNotes String?
  customerSignature    String?
  copyCountAtStart     Int?
  copyCountAtEnd       Int?
  printer              Printer?       @relation(fields: [printerId], references: [id])
  serviceTicket        ServiceTicket? @relation(fields: [serviceTicketId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  timelineEvents WorkOrderTimelineEvent[]
  auditEntries   WorkOrderAuditEntry[]
  partLines      WorkOrderPartLine[]
  files          WorkOrderFile[]

  @@index([status, priority])
  @@index([assignedTechnician, scheduledStart])
  @@index([printerId])
  @@index([customerId])
}

model WorkOrderTimelineEvent {
  id            String    @id @default(cuid())
  workOrderId   String
  type          String
  title         String?
  description   String?
  actor         String?
  previousValue String?
  newValue      String?
  occurredAt    DateTime  @default(now())
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId, occurredAt])
}

model WorkOrderAuditEntry {
  id            String    @id @default(cuid())
  workOrderId   String
  field         String
  previousValue String?
  newValue      String?
  actor         String?
  action        String?
  occurredAt    DateTime  @default(now())
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId, occurredAt])
}

model WorkOrderPartLine {
  id          String    @id @default(cuid())
  workOrderId String
  partNumber  String
  description String?
  quantity    Int       @default(1)
  unitCost    Float?
  source      String?
  addedBy     String?
  addedAt     DateTime  @default(now())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
}

model WorkOrderFile {
  id          String    @id @default(cuid())
  workOrderId String
  kind        String?
  fileName    String
  mimeType    String?
  sizeBytes   Int?
  uploadedBy  String?
  storageRef  String?
  notes       String?
  uploadedAt  DateTime  @default(now())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId, uploadedAt])
}

model PMHistory {
  id              String    @id @default(cuid())
  printerId       String
  pmKitTemplateId String?
  performedAt     DateTime?
  performedById   String?
  meterAtService  Int?
  notes           String?
  printer         Printer   @relation(fields: [printerId], references: [id])
  pmKitTemplate   PMKitTemplate? @relation(fields: [pmKitTemplateId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  syncedAt        DateTime?

  @@index([printerId])
}

model TechnicianNote {
  id        String         @id @default(cuid())
  body      String?
  printerId String?
  ticketId  String?
  authorId  String?
  printer   Printer?       @relation(fields: [printerId], references: [id])
  ticket    ServiceTicket? @relation(fields: [ticketId], references: [id])
  author    User?          @relation(fields: [authorId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  syncedAt  DateTime?

  @@index([printerId])
  @@index([ticketId])
}

// -----------------------------------------------------------------------------
// PARTS, INVENTORY, PM KITS, ORDERS
// -----------------------------------------------------------------------------

model Part {
  id                      String   @id @default(cuid())
  partNumber              String?  @unique
  manufacturerPartNumber  String?
  name                    String
  description             String?
  category                String?
  subcategory             String?
  assembly                String?
  diagramCalloutNumber    String?
  unitOfMeasure           String?  @default("EA")
  preferredVendorId       String?
  alternateVendorIds      String? // JSON array of vendor ids
  unitCost                Float?
  listPrice               Float?
  weight                  Float?
  dimensions              String?
  leadTimeDays            Int?
  warranty                String?
  photoUrl                String?
  technicalDocuments      String? // JSON array of document URLs/paths
  safetyNotes             String?
  status                  String?  @default("ACTIVE") // ACTIVE | INACTIVE
  barcode                 String?
  qrCode                  String?
  reorderLevel            Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deletedAt               DateTime?
  syncedAt                DateTime?

  preferredVendor  Vendor?               @relation("PartPreferredVendor", fields: [preferredVendorId], references: [id])
  inventoryItems   Inventory[]
  pmKitItems       PMKitItem[]
  partsInstalled   PartInstalled[]
  partOrderItems   PartOrderItem[]
  transactions     InventoryTransaction[]
  reservations     InventoryReservation[]
  purchaseLines    PurchaseRequestLine[]
  compatibleModels PrinterModel[]        @relation("PartCompatibleModels")

  @@index([barcode])
  @@index([qrCode])
  @@index([category, subcategory])
  @@index([status])
}

/// Component instance currently installed on a printer (life tracking later).
model PartInstalled {
  id           String    @id @default(cuid())
  printerId    String
  partId       String
  installedAt  DateTime?
  removedAt    DateTime?
  lifeUsedPct  Int?
  printer      Printer   @relation(fields: [printerId], references: [id])
  part         Part      @relation(fields: [partId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  syncedAt     DateTime?

  @@index([printerId])
}

/// Logical stock location: warehouse, truck, customer site, etc.
model WarehouseLocation {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String?
  /// MAIN_WAREHOUSE | REGIONAL_WAREHOUSE | TECHNICIAN_VEHICLE | CUSTOMER_SITE | TEMPORARY_JOB_SITE | CONSIGNMENT | RETURNED_PARTS
  type           String?
  technician     String?
  customerName   String?
  region         String?
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventory      Inventory[]
  sourceTxns     InventoryTransaction[] @relation("TxnSourceLocation")
  destTxns       InventoryTransaction[] @relation("TxnDestLocation")
  reservations   InventoryReservation[]

  @@index([type])
  @@index([code])
}

model Inventory {
  id                  String             @id @default(cuid())
  partId              String
  warehouseLocationId String?
  quantityOnHand      Int                @default(0)
  quantityReserved    Int                @default(0)
  quantityOnOrder     Int                @default(0)
  quantityCommitted   Int                @default(0)
  /// Legacy alias field — prefer quantityOnHand
  quantity            Int                @default(0)
  minimumQuantity     Int?
  maximumQuantity     Int?
  reorderPoint        Int?
  reorderQuantity     Int?
  lastCountDate       DateTime?
  part                Part               @relation(fields: [partId], references: [id])
  warehouseLocation   WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  syncedAt            DateTime?

  @@unique([partId, warehouseLocationId])
  @@index([partId])
  @@index([warehouseLocationId])
}

/// Immutable inventory movement history — never delete rows.
model InventoryTransaction {
  id                     String             @id @default(cuid())
  type                   String // RECEIVE | CONSUME | TRANSFER | RETURN | ADJUSTMENT | CYCLE_COUNT | SCRAP | WARRANTY_RETURN | CUSTOMER_RETURN
  partId                 String
  quantity               Int
  previousOnHand         Int
  newOnHand              Int
  reason                 String?
  userId                 String?
  userName               String?
  workOrderId            String?
  purchaseRequestId      String?
  sourceLocationId       String?
  destinationLocationId  String?
  occurredAt             DateTime           @default(now())
  part                   Part               @relation(fields: [partId], references: [id])
  sourceLocation         WarehouseLocation? @relation("TxnSourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation    WarehouseLocation? @relation("TxnDestLocation", fields: [destinationLocationId], references: [id])
  purchaseRequest        PurchaseRequest?   @relation(fields: [purchaseRequestId], references: [id])
  createdAt              DateTime           @default(now())

  @@index([partId, occurredAt])
  @@index([type, occurredAt])
  @@index([workOrderId])
  @@index([purchaseRequestId])
}

model InventoryReservation {
  id                 String             @id @default(cuid())
  partId             String
  locationId         String
  quantity           Int
  /// SCHEDULED_PM | WORK_ORDER | EMERGENCY_CALL | INSTALLATION
  purpose            String
  relatedRecordId    String?
  relatedRecordType  String?
  reservedBy         String?
  status             String             @default("ACTIVE") // ACTIVE | RELEASED | CONSUMED
  reservedAt         DateTime           @default(now())
  releasedAt         DateTime?
  part               Part               @relation(fields: [partId], references: [id])
  location           WarehouseLocation  @relation(fields: [locationId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([partId, locationId, status])
  @@index([relatedRecordId])
}

model Vendor {
  id                   String   @id @default(cuid())
  name                 String
  contactName          String?
  phone                String?
  email                String?
  supportedPartNumbers String? // JSON array
  leadTimeDays         Int?
  shippingMethods      String? // JSON array
  preferred            Boolean  @default(false)
  onTimeRate           Float?
  qualityScore         Float?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  preferredParts   Part[]            @relation("PartPreferredVendor")
  purchaseRequests PurchaseRequest[]

  @@index([name])
  @@index([preferred])
}

model PurchaseRequest {
  id               String    @id @default(cuid())
  requestNumber    String    @unique
  requesterId      String?
  requesterName    String?
  approverId       String?
  approverName     String?
  /// CRITICAL | HIGH | NORMAL | LOW
  priority         String    @default("NORMAL")
  vendorId         String?
  justification    String?
  expectedDelivery DateTime?
  /// DRAFT | PENDING_APPROVAL | APPROVED | ORDERED | RECEIVED | CANCELLED
  status           String    @default("DRAFT")
  vendor           Vendor?   @relation(fields: [vendorId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lines        PurchaseRequestLine[]
  transactions InventoryTransaction[]

  @@index([status])
  @@index([requesterId])
}

model PurchaseRequestLine {
  id                String          @id @default(cuid())
  purchaseRequestId String
  partId            String
  quantity          Int             @default(1)
  unitCost          Float?
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  part              Part            @relation(fields: [partId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([purchaseRequestId])
}

model PMKitTemplate {
  id             String        @id @default(cuid())
  name           String
  printerModelId String?
  description    String?
  printerModel   PrinterModel? @relation(fields: [printerModelId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items      PMKitItem[]
  pmHistory  PMHistory[]
}

model PMKitItem {
  id              String        @id @default(cuid())
  pmKitTemplateId String
  partId          String
  quantity        Int           @default(1)
  pmKitTemplate   PMKitTemplate @relation(fields: [pmKitTemplateId], references: [id])
  part            Part          @relation(fields: [partId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PartOrder {
  id            String         @id @default(cuid())
  status        String?
  priority      String?
  requestType   String?
  neededBy      DateTime?
  printerId     String?
  ticketId      String?
  requestedById String?
  printer       Printer?       @relation(fields: [printerId], references: [id])
  ticket        ServiceTicket? @relation(fields: [ticketId], references: [id])
  requestedBy   User?          @relation("RequestedByUser", fields: [requestedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  syncedAt      DateTime?

  items PartOrderItem[]

  @@index([status])
}

model PartOrderItem {
  id          String    @id @default(cuid())
  partOrderId String
  partId      String
  quantity    Int       @default(1)
  partOrder   PartOrder @relation(fields: [partOrderId], references: [id])
  part        Part      @relation(fields: [partId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// DIGITAL TWIN SIGNALS
// -----------------------------------------------------------------------------

/// Time-series meter / counter readings for a printer.
model MeterHistory {
  id          String   @id @default(cuid())
  printerId   String
  totalCount  Int?
  blackCount  Int?
  colorCount  Int?
  readAt      DateTime @default(now())
  source      String? // manual | rra | technician
  printer     Printer  @relation(fields: [printerId], references: [id])
  createdAt   DateTime @default(now())

  @@index([printerId, readAt])
}

/// Manual / technician copy-count entries (Patch 33–34 foundation).
model CopyCountHistory {
  id               String   @id @default(cuid())
  printerId        String
  recordedAt       DateTime @default(now())
  copyCount        Int
  enteredBy        String?
  notes            String?
  previousCount    Int?
  lowerCountReason String?
  printer          Printer  @relation(fields: [printerId], references: [id])
  createdAt        DateTime @default(now())

