// -----------------------------------------------------------------------------
// AI AUTOMATION FRAMEWORK (Patch 51A.2)
// -----------------------------------------------------------------------------

model AiOpsAutomationDefinition {
  id                  String    @id @default(cuid())
  organizationId      String
  name                String
  description         String    @default("")
  category            String    @default("GENERAL")
  status              String    @default("DRAFT") // DRAFT|ACTIVE|PAUSED|DISABLED|ARCHIVED
  triggerType         String // EVENT|SCHEDULE|MANUAL|AI_MONITOR
  eventType           String?
  scheduleExpression  String? // cron-like: daily|hourly|every_15m
  timezone            String?   @default("America/New_York")
  conditionMode       String    @default("ALL") // ALL|ANY|CUSTOM
  conditionsJson      String    @default("{}")
  actionsJson         String    @default("[]")
  approvalMode        String    @default("NONE") // NONE|BEFORE_RUN|BEFORE_HIGH_IMPACT_ACTION|ALWAYS
  riskLevel           String    @default("LOW") // LOW|MEDIUM|HIGH|CRITICAL
  dryRunEnabled       Boolean   @default(true)
  maxRetries          Int       @default(1)
  retryDelaySeconds   Int       @default(60)
  timeoutSeconds      Int       @default(120)
  failurePolicy       String    @default("STOP") // STOP|CONTINUE|CONTINUE_OPTIONAL
  lastRunAt           DateTime?
  nextRunAt           DateTime?
  lastRunStatus       String?
  consecutiveFailures Int       @default(0)
  createdById         String?
  updatedById         String?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  executions          AiOpsAutomationExecution[]

  @@index([organizationId, status])
  @@index([triggerType, status])
  @@index([eventType, status])
  @@index([nextRunAt, status])
  @@map("ai_automation_definitions")
}

model AiOpsAutomationExecution {
  id                   String    @id @default(cuid())
  organizationId       String
  automationId         String
  triggerSource        String
  triggerReferenceId   String?
  status               String    @default("QUEUED")
  startedAt            DateTime?
  completedAt          DateTime?
  inputJson            String?
  conditionResultsJson String?
  actionResultsJson    String?
  errorJson            String?
  attemptNumber        Int       @default(1)
  idempotencyKey       String
  initiatedById        String?
  approvedById         String?
  approvedAt           DateTime?
  dryRun               Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  automation           AiOpsAutomationDefinition @relation(fields: [automationId], references: [id], onDelete: Cascade)
  approvals            AiOpsAutomationApproval[]

  @@unique([idempotencyKey])
  @@index([automationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
  @@map("ai_automation_executions")
}

model AiOpsAutomationApproval {
  id             String    @id @default(cuid())
  executionId    String
  status         String    @default("PENDING") // PENDING|APPROVED|REJECTED|EXPIRED|CANCELLED
  requestedById  String?
  assignedRole   String?
  assignedUserId String?
  reason         String
  decisionNote   String?
  decidedById    String?
  decidedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  execution      AiOpsAutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([executionId])
  @@map("ai_automation_approvals")
}

model AiOpsAutomationTemplate {
  id               String   @id @default(cuid())
  name             String
  description      String
  category         String
  icon             String   @default("zap")
  definitionJson   String
  isSystemTemplate Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category, isActive])
  @@map("ai_automation_templates")
}

model AiOpsAutomationEvent {
  id           String    @id @default(cuid())
  organizationId String  @default("org-sfx")
  eventType    String
  entityType   String
  entityId     String
  payloadJson  String
  status       String    @default("PENDING") // PENDING|PROCESSING|PROCESSED|FAILED
  availableAt  DateTime  @default(now())
  processedAt  DateTime?
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())

  @@index([status, availableAt])
  @@index([eventType, createdAt])
  @@index([entityType, entityId])
  @@map("ai_automation_events")
}

model AiOpsAutomationSetting {
  id                              String   @id @default(cuid())
  organizationId                  String   @unique
  automationEnabled               Boolean  @default(true)
  allowAiConditions               Boolean  @default(true)
  defaultApprovalMode             String   @default("BEFORE_HIGH_IMPACT_ACTION")
  defaultMaxRetries               Int      @default(1)
  defaultTimeoutSeconds           Int      @default(120)
  executionRetentionDays          Int      @default(90)
  maxConcurrentRuns               Int      @default(5)
  highImpactActionsRequireApproval Boolean @default(true)
  autoPauseFailureThreshold       Int      @default(5)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("ai_automation_settings")
}

// -----------------------------------------------------------------------------
// PATCH 51A.3 — Predictive Maintenance Intelligence
// Explainable scoring + forecasts; extends PM / AI Ops / automations (no second PM module).
// -----------------------------------------------------------------------------

model MachineHealthSnapshot {
  id                              String    @id @default(cuid())
  organizationId                  String    @default("org-sfx")
  machineId                       String
  healthScore                     Float
  riskLevel                       String // LOW|MODERATE|HIGH|CRITICAL|UNKNOWN
  failureRiskScore                Float     @default(0)
  pmUrgencyScore                  Float     @default(0)
  usageStressScore                Float     @default(0)
  repeatIssueScore                Float     @default(0)
  downtimeRiskScore               Float     @default(0)
  dataQualityScore                Float     @default(0)
  confidenceScore                 Float     @default(0)
  predictedMaintenanceDate        DateTime?
  predictedMaintenanceWindowStart DateTime?
  predictedMaintenanceWindowEnd   DateTime?
  primaryRiskReason               String?
  riskFactorsJson                 String    @default("[]")
  recommendationsJson             String    @default("[]")
  inputSummaryJson                String    @default("{}")
  scoringVersion                  String
  aiExplanationVersion            String?
  aiExplanationJson               String?
  generatedAt                     DateTime  @default(now())
  expiresAt                       DateTime?
  createdAt                       DateTime  @default(now())
  runId                           String?

  recommendations PredictiveMaintenanceRecommendation[]
  alerts          PredictiveRiskAlert[]
  run             PredictiveMaintenanceRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([machineId, generatedAt])
  @@index([organizationId, riskLevel])
  @@index([generatedAt])
  @@index([predictedMaintenanceDate])
  @@map("machine_health_snapshots")
}

model PredictiveMaintenanceRecommendation {
  id                String    @id @default(cuid())
  organizationId    String    @default("org-sfx")
  machineId         String
  healthSnapshotId  String
  recommendationType String // INSPECT|SCHEDULE_PM|EXPEDITE_PM|...
  priority          String    @default("NORMAL") // LOW|NORMAL|HIGH|URGENT
  title             String
  description       String
  reason            String
  confidenceScore   Float     @default(0)
  status            String    @default("OPEN") // OPEN|ACKNOWLEDGED|ACCEPTED|DISMISSED|COMPLETED|EXPIRED
  assignedUserId    String?
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  dismissedById     String?
  dismissedAt       DateTime?
  dismissalReason   String?
  completedAt       DateTime?
  relatedEntityType String?
  relatedEntityId   String?
  dedupeKey         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  healthSnapshot MachineHealthSnapshot @relation(fields: [healthSnapshotId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, priority])
  @@index([machineId, status])
  @@index([healthSnapshotId])
  @@index([dedupeKey, status])
  @@map("predictive_maintenance_recommendations")
}

model PredictiveMaintenanceRun {
  id                     String    @id @default(cuid())
  organizationId         String    @default("org-sfx")
  runType                String // MANUAL|SCHEDULED|EVENT_TRIGGERED|BACKFILL
  status                 String    @default("QUEUED") // QUEUED|RUNNING|SUCCEEDED|PARTIAL|FAILED|CANCELLED
  scopeJson              String    @default("{}")
  machinesEvaluated      Int       @default(0)
  recommendationsCreated Int       @default(0)
  alertsCreated          Int       @default(0)
  errorsCount            Int       @default(0)
  scoringVersion         String
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  initiatedById          String?
  errorJson              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  snapshots MachineHealthSnapshot[]

  @@index([organizationId, startedAt])
  @@index([status, startedAt])
  @@map("predictive_maintenance_runs")
}

model PredictiveRiskAlert {
  id               String    @id @default(cuid())
  organizationId   String    @default("org-sfx")
  machineId        String
  healthSnapshotId String?
  alertType        String
  severity         String // INFO|WARNING|HIGH|CRITICAL
  title            String
  message          String
  status           String    @default("OPEN") // OPEN|ACKNOWLEDGED|RESOLVED|DISMISSED
  dedupeKey        String
  openedAt         DateTime  @default(now())
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  healthSnapshot MachineHealthSnapshot? @relation(fields: [healthSnapshotId], references: [id], onDelete: SetNull)

  @@index([organizationId, dedupeKey, status])
  @@index([organizationId, status, severity])
  @@index([machineId, status])
  @@map("predictive_risk_alerts")
}

model PredictiveMaintenanceSetting {
  id                                  String   @id @default(cuid())
  organizationId                      String   @unique
  enabled                             Boolean  @default(true)
  scheduledEvaluationEnabled          Boolean  @default(false)
  evaluationFrequency                 String   @default("daily")
  healthScoreWarningThreshold         Float    @default(70)
  healthScoreCriticalThreshold        Float    @default(40)
  pmDueSoonDays                       Int      @default(14)
  staleMeterDays                      Int      @default(45)
  repeatFailureLookbackDays           Int      @default(45)
  repeatFailureThreshold              Int      @default(3)
  downtimeLookbackDays                Int      @default(90)
  usageSpikePercent                   Float    @default(40)
  minimumDataQualityScore             Float    @default(40)
  minimumConfidenceForAlert           Float    @default(50)
  autoCreateRecommendations           Boolean  @default(true)
  autoCreateInternalAlerts            Boolean  @default(true)
  requireApprovalForServiceCallCreation Boolean @default(true)
  retentionDays                       Int      @default(180)
  scoringVersion                      String   @default("pm-pred-v1")
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  @@map("predictive_maintenance_settings")
}

model PredictiveScoringProfile {
  id            String   @id @default(cuid())
  organizationId String  @default("org-sfx")
  name          String
  description   String   @default("")
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  machineModel  String?
  weightsJson   String   @default("{}")
  thresholdsJson String  @default("{}")
  version       String   @default("1")
  createdById   String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId, isActive])
  @@index([organizationId, isDefault])
  @@map("predictive_scoring_profiles")
}

model PredictiveOutcomeLink {
  id               String   @id @default(cuid())
  organizationId   String   @default("org-sfx")
  healthSnapshotId String?
  recommendationId String?
  machineId        String
  outcomeType      String // PM_COMPLETED|SERVICE_CALL_CREATED|EMERGENCY_REPAIR|REPEAT_ISSUE|DOWNTIME|RECOMMENDATION_ACCEPTED|RECOMMENDATION_DISMISSED
  relatedEntityType String?
  relatedEntityId  String?
  notes            String?
  createdAt        DateTime @default(now())

  @@index([organizationId, machineId, createdAt])
  @@index([outcomeType, createdAt])
  @@map("predictive_outcome_links")
}

model PredictiveAuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @default("org-sfx")
  action         String
  entityType     String?
  entityId       String?
  actorUserId    String?
  payloadJson    String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@map("predictive_audit_events")
}

// -----------------------------------------------------------------------------
// PATCH 51A.4 — Enterprise Decision Engine
// Ranked, explainable recommendations with human approval. Reuses AI Ops,
// automations, predictive maintenance — does not duplicate those systems.
// -----------------------------------------------------------------------------

model DecisionRecommendation {
  id                      String    @id @default(cuid())
  organizationId          String    @default("org-sfx")
  decisionType            String
  title                   String
  summary                 String
  detailedReasoning       String    @default("")
  sourceType              String
  sourceId                String?
  fingerprint             String
  customerId              String?
  siteId                  String?
  machineId               String?
  serviceCallId           String?
  preventiveMaintenanceId String?
  technicianId            String?
  partId                  String?
  inventoryLocationId     String?
  priority                String    @default("MEDIUM") // CRITICAL|HIGH|MEDIUM|LOW|INFORMATIONAL
  status                  String    @default("NEW")
  confidenceScore         Float     @default(0)
  riskScore               Float     @default(0)
  urgencyScore            Float     @default(0)
  businessImpactScore     Float     @default(0)
  overallDecisionScore    Float     @default(0)
  estimatedDowntimeMinutes Int?
  estimatedLaborMinutes   Int?
  estimatedCost           Float?
  estimatedCostAvoidance  Float?
  slaImpact               String?
  recommendedAction       String
  alternativeActionsJson  String    @default("[]")
  evidenceSnapshotJson    String    @default("{}")
  highImpact              Boolean   @default(false)
  rulesVersion            String    @default("decision-v1")
  aiProvider              String?
  aiModel                 String?
  aiExplanationVersion    String?
  aiExplanationJson       String?
  assignedToUserId        String?
  dueAt                   DateTime?
  reviewedAt              DateTime?
  reviewedBy              String?
  approvedAt              DateTime?
  approvedBy              String?
  rejectedAt              DateTime?
  rejectedBy              String?
  rejectionReason         String?
  deferredUntil           DateTime?
  completedAt             DateTime?
  completedBy             String?
  completionNotes         String?
  supersededById          String?
  usefulRating            Int?
  outcomeUseful           Boolean?
  outcomeConfirmed        Boolean?
  outcomeDowntimeAvoided  Boolean?
  outcomeActualLaborMinutes Int?
  outcomeActualCost       Float?
  outcomeFeedbackJson     String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  history DecisionHistoryEvent[]

  @@index([organizationId, fingerprint, status])
  @@index([organizationId, status, priority])
  @@index([organizationId, decisionType, createdAt])
  @@index([machineId, status])
  @@index([assignedToUserId, status])
  @@index([dueAt])
  @@index([overallDecisionScore])
  @@map("decision_recommendations")
}

model DecisionHistoryEvent {
  id             String   @id @default(cuid())
  organizationId String   @default("org-sfx")
  decisionId     String
  action         String
  fromStatus     String?
  toStatus       String?
  actorUserId    String?
  actorName      String?
  reason         String?
  notes          String?
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())

  decision DecisionRecommendation @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, createdAt])
  @@index([organizationId, createdAt])
  @@map("decision_history_events")
}

model DecisionEngineSetting {
  id                         String   @id @default(cuid())
  organizationId             String   @unique
  enabled                    Boolean  @default(true)
  scheduledRefreshEnabled    Boolean  @default(false)
  riskWeight                 Float    @default(0.35)
  urgencyWeight              Float    @default(0.25)
  businessImpactWeight       Float    @default(0.20)
  slaWeight                  Float    @default(0.10)
  confidenceWeight           Float    @default(0.10)
  highImpactRequiresApproval Boolean  @default(true)
  autoExpireDays             Int      @default(30)
  rulesVersion               String   @default("decision-v1")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("decision_engine_settings")
}

// -----------------------------------------------------------------------------
// PATCH 51A.5 Part 3 — Executive Reporting schedules & cache
// -----------------------------------------------------------------------------

model ExecutiveReportSchedule {
  id             String    @id @default(cuid())
  organizationId String    @default("org-sfx")
  name           String
  period         String // DAILY|WEEKLY|MONTHLY
  format         String    @default("CSV") // CSV|EXCEL|PDF
  enabled        Boolean   @default(true)
  recipientsJson String    @default("[]")
  createdById    String?
  createdByName  String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  /// America/New_York etc. — used for next-run bump documentation; runner uses server local clock.
  timezone       String    @default("America/New_York")
  runHour        Int       @default(6)
  /// REPORT | BRIEFING | KPI_REFRESH | ALERT_REFRESH | CACHE_REFRESH
  jobType        String    @default("REPORT")
  filtersJson    String    @default("{}")
  lastResult     String?
  failureMessage String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, enabled])
  @@index([nextRunAt])
  @@map("executive_report_schedules")
}

model ExecutiveReportCache {
  id             String   @id @default(cuid())
  organizationId String   @default("org-sfx")
  cacheKey       String
  payloadJson    String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([organizationId, cacheKey])
  @@index([expiresAt])
  @@map("executive_report_cache")
}

model ExecutiveReportConfig {
  id             String   @id @default(cuid())
  organizationId String   @default("org-sfx")
  name           String
  period         String   @default("WEEKLY")
  format         String   @default("CSV")
  filtersJson    String   @default("{}")
  sectionsJson   String   @default("[]")
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, updatedAt])
  @@map("executive_report_configs")
}

model ExecutiveReportHistory {
  id             String   @id @default(cuid())
  organizationId String   @default("org-sfx")
  period         String
  format         String
  title          String
  filtersJson    String   @default("{}")
  summaryJson    String   @default("{}")
  filename       String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("executive_report_history")
}

/// Executive Action Center inbox — consolidates risks from existing Matrix modules (not a second engine).
model ExecutiveAlert {
  id                   String    @id @default(cuid())
  organizationId       String    @default("org-sfx")
  alertKey             String
  category             String
  severity             String // CRITICAL|HIGH|MEDIUM|LOW|INFO
  title                String
  explanation          String
  entityType           String?
  entityId             String?
  entityLabel          String?
  href                 String?
  recommendedAction    String?
  status               String    @default("OPEN") // OPEN|ACKNOWLEDGED|RESOLVED|DISMISSED
  ownerId              String?
  ownerName            String?
  sourceType           String?
  sourceRecordId       String?
  detectedAt           DateTime  @default(now())
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolutionNote       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([organizationId, alertKey, status])
  @@index([organizationId, status, severity])
  @@index([organizationId, category])
  @@index([detectedAt])
  @@map("executive_alerts")
}
