// -----------------------------------------------------------------------------
// PATCH 43 — Enterprise Warehouse Management (extends Patch 38 inventory)
// Runtime UI uses sessionStorage; these models are the persistence target.
// -----------------------------------------------------------------------------

model Warehouse {
  id                    String   @id @default(cuid())
  organizationId        String?
  name                  String
  code                  String
  address               String?
  manager               String?
  phone                 String?
  email                 String?
  receivingDock         String?
  shippingArea          String?
  hours                 String?
  status                String   @default("ACTIVE") // ACTIVE | INACTIVE | MAINTENANCE
  region                String?
  enterpriseLocationId  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bins           WarehouseBinLocation[]
  transfersFrom  WarehouseTransfer[] @relation("TransferFromWarehouse")
  transfersTo    WarehouseTransfer[] @relation("TransferToWarehouse")
  receiving      WarehouseReceivingSession[]
  cycleCounts    WarehouseCycleCount[]
  employees      WarehouseEmployee[]
  restocks       TruckRestockRequest[]
  alerts         WarehouseInventoryAlert[]

  @@unique([code])
  @@index([status])
  @@index([enterpriseLocationId])
}

model WarehouseBinLocation {
  id          String    @id @default(cuid())
  warehouseId String
  zone        String
  aisle       String
  rack        String
  shelf       String
  bin         String
  drawer      String    @default("")
  code        String
  active      Boolean   @default(true)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, code])
  @@index([code])
  @@index([zone, aisle])
}

model WarehouseTransfer {
  id               String   @id @default(cuid())
  transferNumber   String   @unique
  kind             String
  status           String
  fromWarehouseId  String
  toWarehouseId    String
  fromLocationId   String?
  toLocationId     String?
  requestedBy      String?
  approvedBy       String?
  notes            String?
  emergency        Boolean  @default(false)
  requestedAt      DateTime @default(now())
  approvedAt       DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  receivedAt       DateTime?
  cancelledAt      DateTime?
  fromWarehouse    Warehouse @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse      Warehouse @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  lines            WarehouseTransferLine[]

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model WarehouseTransferLine {
  id                 String            @id @default(cuid())
  transferId         String
  partId             String?
  partNumber         String
  description        String?
  quantityRequested  Int
  quantityShipped    Int               @default(0)
  quantityReceived   Int               @default(0)
  binFromId          String?
  binToId            String?
  transfer           WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([partNumber])
}

model WarehouseReceivingSession {
