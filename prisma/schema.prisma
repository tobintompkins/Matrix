}

model PortalAuditEntry {
  id            String   @id @default(cuid())
  action        String
  actor         String?
  membershipId  String?
  customerId    String?
  entityType    String?
  entityId      String?
  previousValue String?
  newValue      String?
  sessionInfo   String?
  occurredAt    DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([membershipId])
  @@index([action])
}

// -----------------------------------------------------------------------------
// PATCH 43 — Enterprise Warehouse Management (extends Patch 38 inventory)
// Runtime UI uses sessionStorage; these models are the persistence target.
// -----------------------------------------------------------------------------

model Warehouse {
  id                    String   @id @default(cuid())
  organizationId        String?
  name                  String
  code                  String
  address               String?
  manager               String?
  phone                 String?
  email                 String?
  receivingDock         String?
  shippingArea          String?
  hours                 String?
  status                String   @default("ACTIVE") // ACTIVE | INACTIVE | MAINTENANCE
  region                String?
  enterpriseLocationId  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bins           WarehouseBinLocation[]
  transfersFrom  WarehouseTransfer[] @relation("TransferFromWarehouse")
  transfersTo    WarehouseTransfer[] @relation("TransferToWarehouse")
  receiving      WarehouseReceivingSession[]
  cycleCounts    WarehouseCycleCount[]
  employees      WarehouseEmployee[]
  restocks       TruckRestockRequest[]
  alerts         WarehouseInventoryAlert[]

  @@unique([code])
  @@index([status])
  @@index([enterpriseLocationId])
}

model WarehouseBinLocation {
  id          String    @id @default(cuid())
  warehouseId String
  zone        String
  aisle       String
  rack        String
  shelf       String
  bin         String
  drawer      String    @default("")
  code        String
  active      Boolean   @default(true)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, code])
  @@index([code])
  @@index([zone, aisle])
}

model WarehouseTransfer {
  id               String   @id @default(cuid())
  transferNumber   String   @unique
  kind             String
  status           String
  fromWarehouseId  String
  toWarehouseId    String
  fromLocationId   String?
  toLocationId     String?
  requestedBy      String?
  approvedBy       String?
  notes            String?
  emergency        Boolean  @default(false)
  requestedAt      DateTime @default(now())
  approvedAt       DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  receivedAt       DateTime?
  cancelledAt      DateTime?
  fromWarehouse    Warehouse @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse      Warehouse @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  lines            WarehouseTransferLine[]

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model WarehouseTransferLine {
  id                 String            @id @default(cuid())
  transferId         String
  partId             String?
  partNumber         String
  description        String?
  quantityRequested  Int
  quantityShipped    Int               @default(0)
  quantityReceived   Int               @default(0)
  binFromId          String?
  binToId            String?
  transfer           WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([partNumber])
}

model WarehouseReceivingSession {
  id                     String   @id @default(cuid())
  sessionNumber          String   @unique
  purchaseRequestId      String?
  purchaseRequestNumber  String?
  warehouseId            String
  step                   String
  status                 String
  receiver               String?
  labelsPrinted          Boolean  @default(false)
  notes                  String?
  startedAt              DateTime @default(now())
  completedAt            DateTime?
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])
  lines                  WarehouseReceivingLine[]

  @@index([warehouseId, status])
}

model WarehouseReceivingLine {
  id             String                    @id @default(cuid())
  sessionId      String
  partId         String?
  partNumber     String
  description    String?
  expectedQty    Int
  receivedQty    Int                       @default(0)
  inspectedOk    Boolean                   @default(false)
  inspectNotes   String?
  binLocationId  String?
  locationCode   String?
  session        WarehouseReceivingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model WarehouseCycleCount {
  id              String   @id @default(cuid())
  countNumber     String   @unique
  warehouseId     String
  type            String
  status          String
  categoryFilter  String?
  binFilter       String?
  createdBy       String?
  approvedBy      String?
  notes           String?
  scheduledAt     DateTime @default(now())
  completedAt     DateTime?
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  lines           WarehouseCycleCountLine[]

  @@index([warehouseId, status])
}

model WarehouseCycleCountLine {
  id             String              @id @default(cuid())
  cycleCountId   String
  partId         String?
  partNumber     String
  description    String?
  binLocationId  String?
  locationCode   String?
  expectedQty    Int
  actualQty      Int?
  variance       Int?
  reason         String?
  cycleCount     WarehouseCycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)

  @@index([cycleCountId])
}

model TruckRestockRequest {
  id                 String   @id @default(cuid())
  requestNumber      String   @unique
  truckLocationId    String
  truckName          String?
  technician         String?
  sourceWarehouseId  String
  status             String
  createdBy          String?
  notes              String?
  createdAt          DateTime @default(now())
  completedAt        DateTime?
  sourceWarehouse    Warehouse @relation(fields: [sourceWarehouseId], references: [id])
  lines              TruckRestockLine[]

  @@index([truckLocationId])
  @@index([status])
}

model TruckRestockLine {
  id              String              @id @default(cuid())
  requestId       String
  partId          String?
  partNumber      String
  description     String?
  currentQty      Int
  recommendedQty  Int
  missingQty      Int
  critical        Boolean             @default(false)
  fastMoving      Boolean             @default(false)
  emergencyKit    Boolean             @default(false)
  consumable      Boolean             @default(false)
  request         TruckRestockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model WarehouseInventoryAlert {
  id            String    @id @default(cuid())
  type          String
  title         String
  message       String
  warehouseId   String?
  partNumber    String?
  referenceId   String?
  priority      String    @default("NORMAL")
  createdAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId])
  @@index([type, createdAt])
}

model WarehouseEmployee {
  id          String    @id @default(cuid())
  warehouseId String
  name        String
  role        String?
  phone       String?
  email       String?
  active      Boolean   @default(true)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId])
}

model WarehouseAuditEntry {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  technician       String?
  warehouseId      String?
  inventoryItemId  String?
  partNumber       String?
  quantityBefore   Int?
  quantityAfter    Int?
  adjustment       Int?
  reason           String
  referenceNumber  String?
  sourceModule     String?
  ipAddress        String?
  device           String?

  @@index([warehouseId, timestamp])
  @@index([partNumber])
  @@index([referenceNumber])
}

// -----------------------------------------------------------------------------
// PATCH 45 — PM / Cleaning Count Management (Prisma-backed fleet PM state)
// Digital Twin machine IDs (e.g. MX-GD-001) are the machine keys.
// -----------------------------------------------------------------------------

/// Denormalized per-machine PM state — fleet queries without full Location seed.
model MachinePmState {
  id                   String    @id @default(cuid())
  machineId            String    @unique
  assetTag             String?
  nickname             String?
  printerModel         String?
  customerName         String?
  siteName             String?
  assignedTechnician   String?
  currentMeterCount    Int?
  lastPmCount          Int?
  lastPmAt             DateTime?
  lastPmTechnician     String?
  /// Patch 46 — last completed PM labor minutes
  lastLaborMinutes     Int?
  /// null = Not Configured
  pmInterval           Int?
  /// null = use 10% of interval
  dueSoonThreshold     Int?
  nextPmDueCount       Int?
  modelDefaultInterval Int?
  active               Boolean   @default(true)
  /// Optional link to Printer row when enterprise fleet is seeded.
  printerId            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  history MachinePmHistory[]
  drafts  MachinePmDraft[]

  @@index([active, printerModel])
  @@index([customerName])
  @@index([assignedTechnician])
}

model MachinePmHistory {
  id                     String   @id @default(cuid())
  machinePmStateId       String
  machineId              String
  completedAt            DateTime
  countAtCompletion      Int
  previousPmCount        Int?
  pmIntervalAtCompletion Int
  technician             String
  recordedBy             String?
  notes                  String?
  idempotencyKey         String?  @unique
  /// Patch 46 — workflow & documentation
  timeStarted            DateTime?
  timeFinished           DateTime?
  laborMinutes           Int?
  qualityScore           Float?
  checklistJson          String?
  checklistCompletionPct Float?
  partsUsedJson          String?
  statusAtCompletion     String?
  workPerformed          String?
  customerSignaturePlaceholder String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  machinePmState         MachinePmState @relation(fields: [machinePmStateId], references: [id], onDelete: Cascade)

  @@index([machineId, completedAt])
  @@index([machinePmStateId, completedAt])
  @@index([technician, completedAt])
}

/// Meter readings that update PM state (do not create PM history by themselves).
model MachinePmMeterEntry {
  id               String   @id @default(cuid())
  machineId        String
  meterCount       Int
  previousCount    Int?
  enteredBy        String
  notes            String?
  lowerCountReason String?
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  idempotencyKey   String?  @unique

  @@index([machineId, recordedAt])
}

/// Patch 46 — configurable PM checklist template per printer model.
model MachinePmChecklistTemplate {
  id           String   @id @default(cuid())
  printerModel String
  itemKey      String
  taskName     String
  description  String?
  sortOrder    Int      @default(0)
  required     Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([printerModel, itemKey])
  @@index([printerModel, active, sortOrder])
}

/// Patch 46 — in-progress PM draft (save / resume).
model MachinePmDraft {
  id               String   @id @default(cuid())
  machinePmStateId String
  machineId        String
  technician       String
  checklistJson    String
  partsUsedJson    String?
  notes            String?
  timeStarted      DateTime?
  meterReading     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  machinePmState   MachinePmState @relation(fields: [machinePmStateId], references: [id], onDelete: Cascade)

  @@unique([machineId, technician])
  @@index([machineId])
}

/// Patch 46 — PM audit trail (never delete history rows).
model MachinePmAuditLog {
  id            String   @id @default(cuid())
  machineId     String?
  user          String?
  action        String
  previousValue String?
  newValue      String?
  details       String?
  createdAt     DateTime @default(now())

  @@index([machineId, createdAt])
  @@index([action, createdAt])
}

// -----------------------------------------------------------------------------
// PATCH 44 — PM Intelligence (sessionStorage runtime; Prisma persistence target)
// -----------------------------------------------------------------------------

model PmMeterReading {
  id                        String   @id @default(cuid())
  printerId                 String
  meterCount                Int
  previousCount             Int?
  countIncrease             Int?
  recordedAt                DateTime
  countTime                 String?
  operatingHours            Float?
  colorCount                Int?
  blackCount                Int?
  duplexCount               Int?
  scanCount                 Int?
  notes                     String?
  source                    String
  enteredBy                 String?
  photoUrl                  String?
  validationOverrideReason  String?
  suspectedReset            Boolean  @default(false)
  unusualIncrease           Boolean  @default(false)
  createdAt                 DateTime @default(now())

  @@index([printerId, recordedAt])
}

model PmIntervalRule {
  id                     String   @id @default(cuid())
  name                   String
  printerModel           String
  maintenanceType        String
  startingMeter          Int      @default(0)
  intervalCount          Int
  warningThreshold       Int
  criticalThreshold      Int
  graceThreshold         Int
  dateBasedIntervalDays  Int?
  requiredPartsKitId     String?
  estimatedLaborHours    Float    @default(2)
  instructions           String?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([printerModel])
}

model PmCleaningCompletion {
  id                 String    @id @default(cuid())
  printerId          String
  cleaningType       String
  completedAt        DateTime
  completedMeter     Int
  technician         String?
  timeSpentMinutes   Int?
  conditionBefore    String?
  conditionAfter     String?
  suppliesUsedJson   String?
  partsUsedJson      String?
  photosJson         String?
  notes              String?
  customerSignature  String?
  followUpRequired   Boolean   @default(false)
  nextCleaningCount  Int?
  nextCleaningDate   DateTime?

  @@index([printerId])
}

model PmIntelligenceAudit {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  user           String?
  action         String
  printerId      String?
  customerName   String?
  previousValue  String?
  newValue       String?
  reason         String?
  sourceModule   String?
  device         String?
  ipAddress      String?
  workOrderId    String?
  pmEventId      String?

  @@index([printerId, timestamp])
  @@index([action])
}

// -----------------------------------------------------------------------------
// MATRIX ASSIST (Patch 48) — advisory technician diagnostics
// Steps are stored relationally (MatrixAssistDiagnosticStep). Suggested causes
// and template payloads use JSON strings for flexible structured blobs.
// Clerk user ids are stored as strings (no Prisma User FK) — same pattern as PM.
// -----------------------------------------------------------------------------

model MatrixAssistDiagnosticSession {
  id                       String    @id @default(cuid())
  organizationId           String?
  serviceCallId            String?
  machineId                String?
  customerId               String?
  technicianId             String?
  technicianName           String?
  status                   String    @default("DRAFT") // DRAFT | IN_PROGRESS | COMPLETED | CANCELLED
  reportedSymptom          String?
  technicianObservations   String?
  assistantSummary         String?
  suggestedCausesJson      String?
  troubleshootingStepsJson String?
  technicianConclusion     String?
  workflowStep             Int       @default(1)
  modelHint                String?
  errorCode                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  completedAt              DateTime?

  steps     MatrixAssistDiagnosticStep[]
  messages  MatrixAssistMessage[]
  feedback  MatrixAssistFeedback[]

  @@index([organizationId, createdAt])
  @@index([serviceCallId])
  @@index([machineId])
  @@index([technicianId, status])
}

model MatrixAssistDiagnosticStep {
  id                   String   @id @default(cuid())
  diagnosticSessionId  String
  stepOrder            Int
  title                String
  instructions         String?
  result               String   @default("NOT_STARTED") // NOT_STARTED | PASSED | FAILED | NOT_APPLICABLE
  technicianNote       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  session MatrixAssistDiagnosticSession @relation(fields: [diagnosticSessionId], references: [id], onDelete: Cascade)

  @@index([diagnosticSessionId, stepOrder])
}

model MatrixAssistMessage {
  id                   String   @id @default(cuid())
  organizationId       String?
  diagnosticSessionId  String?
  serviceCallId        String?
  machineId            String?
  userId               String?
  role                 String // USER | ASSISTANT | SYSTEM
  content              String
  createdAt            DateTime @default(now())

  session MatrixAssistDiagnosticSession? @relation(fields: [diagnosticSessionId], references: [id], onDelete: Cascade)

  @@index([diagnosticSessionId, createdAt])
  @@index([organizationId, createdAt])
}

model MatrixAssistFeedback {
  id                   String   @id @default(cuid())
  organizationId       String?
  diagnosticSessionId  String?
  messageId            String?
  userId               String?
  rating               String // HELPFUL | NOT_HELPFUL | PARTIALLY_HELPFUL
  reason               String?
  comment              String?
  createdAt            DateTime @default(now())

  session MatrixAssistDiagnosticSession? @relation(fields: [diagnosticSessionId], references: [id], onDelete: Cascade)

  @@index([diagnosticSessionId])
}

model MatrixAssistUsageEvent {
  id                 String   @id @default(cuid())
  organizationId     String?
  userId             String?
  eventType          String
  durationMs         Int?
  tokenUsage         Int?
  estimatedCostCents Int?
  errorCode          String?
  createdAt          DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([eventType, createdAt])
}

model TroubleshootingTemplate {
  id                     String   @id @default(cuid())
  organizationId         String?
  printerModel           String?
  machineFamily          String?
  symptomCategory        String
  errorCode              String?
  assembly               String?
  title                  String
  safetyNotes            String?
  stepsJson              String
  relatedPartsJson       String?
  documentationRefsJson  String?
  active                 Boolean  @default(true)
  version                Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([symptomCategory, printerModel])
  @@index([errorCode])
}

model MatrixAssistSettings {
  id                              String   @id @default(cuid())
  organizationId                  String?  @unique
  enabled                         Boolean  @default(true)
  allowHistorySummaries           Boolean  @default(true)
  allowPartsSuggestions           Boolean  @default(true)
  allowServiceNoteDrafts          Boolean  @default(true)
  allowTroubleshootingTemplates   Boolean  @default(true)
  requireFeedbackOnComplete       Boolean  @default(false)
  maxResponseLength               Int      @default(4000)
  conversationRetentionDays       Int      @default(90)
  approvedModel                   String?
  disclaimerOverride              String?
  updatedBy                       String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// ENTERPRISE ADMINISTRATION CENTER (Patch 49A)
// Application directory + config — Clerk remains the identity provider.
// Deactivation preserves historical operational records.
// -----------------------------------------------------------------------------

model AdminDirectoryUser {
  id                   String    @id @default(cuid())
  organizationId       String
  clerkUserId          String?
  email                String
  name                 String
  matrixRole           String
  status               String    @default("Active") // Active | Inactive | Invited | Pending | Suspended | Deactivated
  isActive             Boolean   @default(true)
  primaryRegionId      String?
  managerId            String?
  accessScope          String    @default("ORGANIZATION") // SELF | ASSIGNED_WORK | TEAM | REGION | ORGANIZATION
  lastActiveAt         DateTime?
  deactivatedAt        DateTime?
  deactivatedByUserId  String?
  deactivationReason   String?
  updatedAtVersion     Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, matrixRole])
  @@index([primaryRegionId])
  @@index([managerId])
}

model AdminRegion {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  label          String
  description    String?
  active         Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, active])
}

model AdminFeatureControl {
  id             String   @id @default(cuid())
  organizationId String
  featureKey     String
  enabled        Boolean  @default(true)
  description    String?
  updatedByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, featureKey])
  @@index([organizationId])
}

model AdminConfigurationEntry {
  id                String   @id @default(cuid())
  organizationId    String
  configurationType String
  key               String
  label             String
  description       String?
  active            Boolean  @default(true)
  displayOrder      Int      @default(0)
  protected         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, configurationType, key])
  @@index([organizationId, configurationType, active])
}

model AdminOrganizationProfile {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  legalName           String?
  displayName         String?
  supportEmail        String?
  supportPhone        String?
  website             String?
  address             String?
  defaultTimeZone     String?  @default("America/New_York")
  dateFormat          String?  @default("MM/dd/yyyy")
  timeFormat          String?  @default("12h")
  defaultRegionId     String?
  defaultWarehouseId  String?
  businessHours       String?
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
