  @@index([organizationId])
}

model AdminConfigurationEntry {
  id                String   @id @default(cuid())
  organizationId    String
  configurationType String
  key               String
  label             String
  description       String?
  active            Boolean  @default(true)
  displayOrder      Int      @default(0)
  protected         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, configurationType, key])
  @@index([organizationId, configurationType, active])
}

model AdminOrganizationProfile {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  legalName           String?
  displayName         String?
  supportEmail        String?
  supportPhone        String?
  website             String?
  address             String?
  defaultTimeZone     String?  @default("America/New_York")
  dateFormat          String?  @default("MM/dd/yyyy")
  timeFormat          String?  @default("12h")
  defaultRegionId     String?
  defaultWarehouseId  String?
  businessHours       String?
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── Patch 50A — Enterprise Approval Center ─────────────────────────────────

model ApprovalRequestSequence {
  id             String @id @default(cuid())
  organizationId String
  year           Int
  lastValue      Int    @default(0)

  @@unique([organizationId, year])
}

model ApprovalRequest {
  id                     String    @id @default(cuid())
  organizationId         String
  requestNumber          String
  title                  String
  description            String?
  businessJustification  String?
  approvalType           String
  sourceModule           String?
  sourceRecordId         String?
  status                 String    @default("DRAFT")
  priority               String    @default("NORMAL")
  requesterUserId        String
  requesterName          String?
  requesterDepartmentId  String?
  currentStepNumber      Int       @default(0)
  totalSteps             Int       @default(0)
  assignedApproverUserId String?
  assignedApproverName   String?
  requestedAmount        Float?
  currency               String?   @default("USD")
  dueAt                  DateTime?
  submittedAt            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  escalatedAt            DateTime?
  archivedAt             DateTime?
  selectedRuleId         String?
  customerId             String?
  machineId              String?
  serviceCallId          String?
  partsOrderId           String?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  steps        ApprovalStep[]
  decisions    ApprovalDecision[]
  comments     ApprovalComment[]
  assignments  ApprovalAssignment[]
  attachments  ApprovalAttachment[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
  @@index([organizationId, assignedApproverUserId])
  @@index([organizationId, requesterUserId])
  @@index([organizationId, approvalType])
  @@index([organizationId, dueAt])
  @@index([organizationId, archivedAt])
}

model ApprovalStep {
  id                String    @id @default(cuid())
  approvalRequestId String
  stepNumber        Int
  name              String
  approverType      String    @default("PERMISSION")
  requiredRoleId    String?
  requiredPermission String?
  assignedUserId    String?
  assignedUserName  String?
  status            String    @default("WAITING")
  minimumApprovals  Int       @default(1)
  approvalsReceived Int       @default(0)
  dueAt             DateTime?
  completedAt       DateTime?
  optional          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  request     ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  decisions   ApprovalDecision[]
  assignments ApprovalAssignment[]

  @@unique([approvalRequestId, stepNumber])
  @@index([approvalRequestId, status])
}

model ApprovalDecision {
  id                String   @id @default(cuid())
  approvalRequestId String
  approvalStepId    String?
  decision          String
  decidedByUserId   String
  decidedByName     String?
  decidedByRoleName String?
  comment           String?
  signatureHash     String
  decidedAt         DateTime @default(now())
  metadata          String?
  createdAt         DateTime @default(now())

  request ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  step    ApprovalStep?   @relation(fields: [approvalStepId], references: [id], onDelete: SetNull)

  @@index([approvalRequestId, decidedAt])
  @@unique([approvalRequestId, approvalStepId, decidedByUserId, decision])
}

model ApprovalComment {
  id                String    @id @default(cuid())
  approvalRequestId String
  parentCommentId   String?
  authorUserId      String
  authorName        String?
  authorRole        String?
  body              String
  isInternal        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  request ApprovalRequest  @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  parent  ApprovalComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies ApprovalComment[] @relation("CommentReplies")

  @@index([approvalRequestId, createdAt])
}

model ApprovalAssignment {
  id                String    @id @default(cuid())
  approvalRequestId String
  approvalStepId    String?
  assignedToUserId  String
  assignedToName    String?
  assignedByUserId  String
  assignedByName    String?
  assignmentType    String
  reason            String?
  startsAt          DateTime  @default(now())
  endsAt            DateTime?
  createdAt         DateTime  @default(now())

  request ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  step    ApprovalStep?   @relation(fields: [approvalStepId], references: [id], onDelete: SetNull)

  @@index([approvalRequestId])
}

model ApprovalRule {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  description        String?
  approvalType       String
  sourceModule       String?
  isActive           Boolean  @default(true)
  priority           Int      @default(100)
  conditionsJson     String
  workflowJson       String
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, approvalType, isActive])
  @@index([organizationId, priority])
}

model ApprovalAttachment {
  id                String   @id @default(cuid())
  approvalRequestId String
  fileName          String
  fileUrl           String
  mimeType          String?
  fileSize          Int?
  uploadedByUserId  String
  createdAt         DateTime @default(now())

  request ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
}

