// -----------------------------------------------------------------------------
// PATCH 45 — PM / Cleaning Count Management (Prisma-backed fleet PM state)
// Digital Twin machine IDs (e.g. MX-GD-001) are the machine keys.
// -----------------------------------------------------------------------------

/// Denormalized per-machine PM state — fleet queries without full Location seed.
model MachinePmState {
  id                   String    @id @default(cuid())
  machineId            String    @unique
  assetTag             String?
  nickname             String?
  printerModel         String?
  customerName         String?
  siteName             String?
  assignedTechnician   String?
  currentMeterCount    Int?
  lastPmCount          Int?
  lastPmAt             DateTime?
  lastPmTechnician     String?
  /// Patch 46 — last completed PM labor minutes
  lastLaborMinutes     Int?
  /// null = Not Configured
  pmInterval           Int?
  /// null = use 10% of interval
  dueSoonThreshold     Int?
  nextPmDueCount       Int?
  modelDefaultInterval Int?
  active               Boolean   @default(true)
  /// Optional link to Printer row when enterprise fleet is seeded.
  printerId            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  history MachinePmHistory[]
  drafts  MachinePmDraft[]

  @@index([active, printerModel])
  @@index([customerName])
  @@index([assignedTechnician])
}

model MachinePmHistory {
  id                     String   @id @default(cuid())
  machinePmStateId       String
  machineId              String
  completedAt            DateTime
  countAtCompletion      Int
  previousPmCount        Int?
  pmIntervalAtCompletion Int
  technician             String
  recordedBy             String?
  notes                  String?
  idempotencyKey         String?  @unique
  /// Patch 46 — workflow & documentation
  timeStarted            DateTime?
  timeFinished           DateTime?
  laborMinutes           Int?
  qualityScore           Float?
  checklistJson          String?
  checklistCompletionPct Float?
  partsUsedJson          String?
  statusAtCompletion     String?
  workPerformed          String?
  customerSignaturePlaceholder String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  machinePmState         MachinePmState @relation(fields: [machinePmStateId], references: [id], onDelete: Cascade)

  @@index([machineId, completedAt])
  @@index([machinePmStateId, completedAt])
  @@index([technician, completedAt])
}

/// Meter readings that update PM state (do not create PM history by themselves).
model MachinePmMeterEntry {
  id               String   @id @default(cuid())
  machineId        String
  meterCount       Int
  previousCount    Int?
  enteredBy        String
  notes            String?
  lowerCountReason String?
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  idempotencyKey   String?  @unique

  @@index([machineId, recordedAt])
}

/// Patch 46 — configurable PM checklist template per printer model.
model MachinePmChecklistTemplate {
  id           String   @id @default(cuid())
  printerModel String
  itemKey      String
  taskName     String
  description  String?
  sortOrder    Int      @default(0)
  required     Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([printerModel, itemKey])
  @@index([printerModel, active, sortOrder])
}

/// Patch 46 — in-progress PM draft (save / resume).
model MachinePmDraft {
  id               String   @id @default(cuid())
  machinePmStateId String
  machineId        String
  technician       String
  checklistJson    String
  partsUsedJson    String?
  notes            String?
  timeStarted      DateTime?
  meterReading     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  machinePmState   MachinePmState @relation(fields: [machinePmStateId], references: [id], onDelete: Cascade)

  @@unique([machineId, technician])
  @@index([machineId])
}

/// Patch 46 — PM audit trail (never delete history rows).
model MachinePmAuditLog {
  id            String   @id @default(cuid())
  machineId     String?
  user          String?
  action        String
  previousValue String?
  newValue      String?
  details       String?
  createdAt     DateTime @default(now())

  @@index([machineId, createdAt])
  @@index([action, createdAt])
}

// -----------------------------------------------------------------------------
// PATCH 44 — PM Intelligence (sessionStorage runtime; Prisma persistence target)
// -----------------------------------------------------------------------------

model PmMeterReading {
  id                        String   @id @default(cuid())
  printerId                 String
  meterCount                Int
